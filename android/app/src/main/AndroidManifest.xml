<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the page's navigator.onLine and online/offline events follow
         the real connection, which sync waits on. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- No backup and no device transfer. Release 3 (the TWA) had
         allowBackup on, but its data lived in Chrome, so nothing of the
         person's was in it. Here the WebView's storage is the app's own and
         holds the schedule and the sign-in session. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PieTimers.Starting"
        android:usesCleartextTraffic="false">

        <!-- configChanges: the page keeps its state through a rotation or a
             keyboard instead of being reloaded. Not uiMode: a dark mode
             switch recreates the screen so the page's "Match my device"
             theme follows it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:label="@string/launcher_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links to the site open in the app, as they did in release 3.
                 Verified against app/.well-known/assetlinks.json, which lists
                 Google's app signing key for this package. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pietimers.aibhlinn.ai"
                    android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
