<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup as release 3 (the TWA) had it. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PieTimers.Starting"
        android:usesCleartextTraffic="false">

        <!-- configChanges: the page keeps its state through a rotation, a
             keyboard or a dark-mode switch instead of being reloaded. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:label="@string/launcher_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links to the site open in the app, as they did in release 3.
                 Verified against app/.well-known/assetlinks.json, which lists
                 Google's app signing key for this package. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pietimers.aibhlinn.ai"
                    android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
