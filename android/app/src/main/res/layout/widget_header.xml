<?xml version="1.0" encoding="utf-8"?>
<!-- The top line of both sides of the widget: "Pie Timers" with its pie
     on the left, "AibhlínnAI" with its mark on the right. Tapping either
     turns the widget over to that one's QR code. The empty FrameLayout
     pushes them apart: a widget may not hold a plain View. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/widget_brand_pie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/widget_brand_pie_about"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingTop="9dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginRight="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_icon_pie" />

        <TextView
            style="@style/Widget.PieTimers.Brand"
            android:text="@string/widget_brand_pie" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/widget_brand_ai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/widget_brand_ai_about"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="9dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp">

        <TextView
            style="@style/Widget.PieTimers.Brand"
            android:text="@string/widget_brand_ai" />

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginLeft="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_mark_ai" />
    </LinearLayout>
</LinearLayout>
