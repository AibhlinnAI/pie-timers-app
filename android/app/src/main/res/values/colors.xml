<resources>
    <!-- The site's theme-color, behind the system bars and the splash. -->
    <color name="app_background">#1C1024</color>
    <color name="text">#F4EEF8</color>
    <color name="text_muted">#C9BDD3</color>
    <!-- The pie's orange, from the icon. -->
    <color name="accent">#FF8A00</color>
    <color name="on_accent">#1C1024</color>

    <!-- The home screen widget. The site's dark theme (app/styles.css),
         whatever the phone's own theme: a widget sits on a wallpaper, and
         one look is easier to know at a glance than two. -->
    <color name="widget_background">#241730</color>
    <color name="widget_text">#EFE6F5</color>
    <color name="widget_text_muted">#B4A3C0</color>
    <!-- What the eaten part of a pie shows. -->
    <color name="widget_plate">#32493C</color>
    <color name="widget_pie_break">#B07FE0</color>
    <color name="widget_pie_end">#7FB08C</color>
    <color name="widget_pie_appointment">#F3921B</color>
    <!-- Nearly out of time: green for a break or the end of the day,
         which is good news, and crimson for an appointment. -->
    <color name="widget_urgent_good">#6FD08C</color>
    <color name="widget_urgent">#D91E48</color>
    <color name="widget_urgent_edge">#FFD2DC</color>
    <!-- Nothing running: one quiet colour, so it never looks live. -->
    <color name="widget_off">#8B9A90</color>
    <color name="widget_off_plate">#3A3340</color>
</resources>
