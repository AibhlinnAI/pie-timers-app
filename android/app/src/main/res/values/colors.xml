<resources>
    <!-- The site's theme-color, behind the system bars and the splash. -->
    <color name="app_background">#1C1024</color>
    <color name="text">#F4EEF8</color>
    <color name="text_muted">#C9BDD3</color>
    <!-- The pie's orange, from the icon. -->
    <color name="accent">#FF8A00</color>
    <color name="on_accent">#1C1024</color>

    <!-- The home screen widget, in the conference shirt's colours: its
         purple for the ground, its cream for the numbers, and the app
         icon's green plate. One look whatever the phone's theme, because
         a widget sits on a wallpaper. -->
    <color name="widget_background">#4B2A5A</color>
    <color name="widget_text">#F6D7B0</color>
    <color name="widget_text_muted">#D7CCE2</color>
    <!-- The plate and its rim. What is eaten shows the plate. -->
    <color name="widget_plate">#32493C</color>
    <color name="widget_plate_rim">#3E5A4A</color>
    <!-- The app's meaning for each colour (purple for a break, green for
         the end of the day, orange for an appointment), each lightened
         until it stands out on the green plate. -->
    <color name="widget_pie_break">#D9B3F2</color>
    <color name="widget_pie_end">#A8E0B5</color>
    <color name="widget_pie_appointment">#FF8A00</color>
    <!-- Nearly out of time: green for a break or the end of the day,
         which is good news, and crimson for an appointment. -->
    <color name="widget_urgent_good">#6FD08C</color>
    <color name="widget_urgent">#D91E48</color>
    <color name="widget_urgent_edge">#FFD2DC</color>
    <!-- Nothing running: one quiet colour, so it never looks live. -->
    <color name="widget_off">#B9A8C4</color>
    <color name="widget_off_plate">#3D2349</color>
</resources>
