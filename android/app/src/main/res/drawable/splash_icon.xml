<?xml version="1.0" encoding="utf-8"?>
<!-- The splash icon box is 288dp and Android masks it to a 192dp circle.
     The maskable icon's pie fills about 72% of it, so at 240dp the pie
     (about 173dp) sits inside the circle, and its dark square matches the
     splash background where the mask cuts it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="288dp"
        android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="240dp"
        android:height="240dp"
        android:drawable="@mipmap/ic_maskable"
        android:gravity="center" />
</layer-list>
